# Hosted mode (Vercel + Supabase). Set these in the Vercel project, never commit values.
# The server refuses to start unless AUTH_MODE=supabase. Provider keys are never read here:
# in hosted mode they live only in each user's browser.
AUTH_MODE=supabase

# Supabase project URL, e.g. https://<ref>.supabase.co (Config)
SUPABASE_URL=
# Publishable key (sb_publishable_...), safe for the browser (Config)
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...), server only (Secret)
SUPABASE_SECRET_KEY=
# Transaction pooler connection string, port 6543, with the database password (Secret)
DATABASE_URL=

# Comma-separated emails that may act as admin (Config)
ADMIN_EMAILS=
# Comma-separated Host values the API answers to, e.g. your-app.vercel.app (Config)
ALLOWED_HOSTS=
# Public URL of the app, used for password-recovery redirects (Config)
APP_URL=
