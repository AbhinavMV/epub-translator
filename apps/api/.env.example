# Copy to apps/api/.env and fill in at least one key. Keys never leave this server.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional model overrides (defaults: claude-sonnet-5-5; OpenAI/Gemini use the first listed model)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=
# GEMINI_MODEL=

# PORT=8787
# DATA_DIR=./data
# Offline "Offline test (no translation)" provider for trying the UI without spending tokens
# ENABLE_FAKE_PROVIDER=1
# FAKE_PROVIDER_DELAY_MS=300

# Batch mode (50% cost, results within 24h): how often open vendor batches are polled
# BATCH_POLL_INTERVAL_MS=60000
# FAKE_BATCH_FETCHES=2
